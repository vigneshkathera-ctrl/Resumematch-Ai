# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or Atlas cluster URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resumematch?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
